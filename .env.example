# ODPT developer registration and API key are required. Never expose this key to the browser.
ODPT_API_KEY=
# Paste the exact endpoint URLs shown in your ODPT data catalog.
# The server adds/replaces the acl:consumerKey parameter using ODPT_API_KEY.
ODPT_VEHICLE_POSITIONS_URL=
ODPT_TRIP_UPDATES_URL=
ODPT_SERVICE_ALERTS_URL=
# GTFS-JP ZIP endpoint from the official ODPT catalog.
ODPT_GTFS_STATIC_URL=
# Supabase credentials are server-side only. Never use NEXT_PUBLIC_ for these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
